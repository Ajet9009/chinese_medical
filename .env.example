# 复制为仓库根目录 .env 或 common/.env。根目录 .env 会覆盖 common/.env。

# 大模型（OpenAI 兼容；空 model_type 走这里）
MODEL_API_KEY=sk-xxx
MODEL_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat

# 可选：聊天页切换 DeepSeek / 通义 / 豆包（未配 key 的选项会灰掉）。
# 下拉只切问答图节点；历史压缩 / 长期记忆 / 评测仍用上面的 MODEL_*。
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# QWEN_API_KEY=
# DASHSCOPE_API_KEY=
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_LLM_MODEL=qwen-plus
# DOUBAO_API_KEY=
# ARK_API_KEY=
# DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# DOUBAO_LLM_ENDPOINT_ID=ep-xxxx

# Neo4j（本机已有实例，不进 docker-compose）
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=xxx

# 向量检索
EMBEDDING_MODEL_PATH=path/to/bge-large-zh-v1.5
FAISS_INDEX_PATH=path/to/entities.index
FAISS_METADATA_PATH=path/to/entities.json
MATCH_MIN_SCORE=0.6
MATCH_TOP_K=3
MATCH_DROP_RATIO=0.6

# 会话（W1 条数硬顶 + W2 token 预算）
REDIS_URL=redis://localhost:6379/0
CONVERSATION_DB_PATH=data/conversations.sqlite
REDIS_HISTORY_MAX=50
GRAPH_HISTORY_LIMIT=6
# 历史+摘要的 token 上限（系统提示、图谱结果、当前问句另算）。LTRIM 仍按条数。
TOKEN_BUDGET=2000
# CONTEXT_COMPRESS=0 时退回 GRAPH_HISTORY_LIMIT 条数截断
# CONTEXT_COMPRESS=1

DOC_RAG_ENABLE=1
DOC_SOURCE_DIR=corpus
DOC_FAISS_INDEX_PATH=data/faiss/docs.index
DOC_FAISS_METADATA_PATH=data/faiss/docs.json
DOC_CHUNK_SIZE=400
DOC_CHUNK_OVERLAP=80
DOC_TOP_K=4
DOC_MIN_SCORE=0.35
DOC_HYBRID_ENABLE=1
RRF_K=60
RRF_DENSE_WEIGHT=1.0
RRF_SPARSE_WEIGHT=1.0
MMR_ENABLE=1
MMR_LAMBDA=0.5
CRAG_ENABLE=1
CRAG_HIGH=0.72
CRAG_LOW=0.3
CRAG_REWRITE_ENABLE=1
CITATION_OVERLAP=0.08
CITATION_VERIFY_SIM_THRESHOLD=0.35
DOC_UPLOAD_MAX_BYTES=8388608
KNOWLEDGE_DOCS_DIR=data/docs

# 登录（W4）
JWT_SECRET=please-change-this-to-a-random-long-string
JWT_EXPIRE_MINUTES=1440
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# 同一 IP 窗口内最多尝试次数；测试未设置时不限流。生产默认 10 次 / 60 秒。
# LOGIN_RATE_MAX=10
# LOGIN_RATE_WINDOW=60

# 运行日志（stderr + 轮转文件；TESTING=1 不写盘）
# LOG_DIR=data/logs

# 黄金集（W5 离线评测；点踩可回流。data/ 已 gitignore，文件放 eval/）
GOLDEN_QA_PATH=eval/golden_qa.json

# Langfuse（可观测性，可关）
LANGFUSE_SECRET_KEY=sk-lf-xxx
LANGFUSE_PUBLIC_KEY=pk-lf-xxx
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_ENABLED=true
LANGFUSE_SAMPLE_RATE=1.0
LANGFUSE_UNMASK=false
SERVICE_VERSION=1.0.0
