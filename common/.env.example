# ── 记忆系统基础设施（_008_memory）──
# Redis 短期记忆
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# MySQL 用户画像 / 审计
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=subjects_kg
MYSQL_PROFILE_TABLE=agent_user_profile
MYSQL_AUDIT_TABLE=agent_memory_audit
MYSQL_POOL_SIZE=4

# Milvus 长期记忆（独立 collection，勿用业务 edurag）
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_DATABASE=itcast
MILVUS_MEMORY_COLLECTION=agent_long_term_memory
MEMORY_EMBED_DIM=1024

# 后端选择：milvus|json ， mysql|json ， mysql|json|off
MEMORY_LONG_BACKEND=milvus
MEMORY_PROFILE_BACKEND=mysql
MEMORY_AUDIT_BACKEND=mysql
MEMORY_ASYNC_EXTRACT=true
MEMORY_EXTRACT_WORKERS=2
MEMORY_EXTRACT_QUEUE_SIZE=64
MEMORY_SHORT_TTL_SECONDS=604800
MEMORY_SHORT_ROUNDS=20
